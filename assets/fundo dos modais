/* =========================================
   FUNDO DOS MODAIS — JARDIM ENCANTADO
   ========================================= */

.modal {
  position: fixed;
  inset: 0;
  z-index: 60;

  display: none;
  align-items: center;
  justify-content: center;

  padding: 14px;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 50% 45%,
      rgba(92, 113, 82, 0.20) 0%,
      rgba(26, 42, 30, 0.55) 38%,
      rgba(9, 18, 12, 0.86) 70%,
      rgba(3, 9, 6, 0.96) 100%
    );

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  opacity: 0;
  transition: opacity 0.35s ease;
}

.modal.ativo {
  display: flex;
  opacity: 1;
}


/* =========================================
   CAMADA DE LUZES / VAGALUMES
   ========================================= */

.modal::before {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;
  z-index: 0;

  background:
    radial-gradient(
      circle at 12% 18%,
      rgba(255, 224, 144, 0.70) 0 1.5px,
      rgba(255, 224, 144, 0.18) 2px,
      transparent 7px
    ),

    radial-gradient(
      circle at 82% 14%,
      rgba(255, 232, 168, 0.65) 0 1.8px,
      rgba(255, 232, 168, 0.16) 2.2px,
      transparent 8px
    ),

    radial-gradient(
      circle at 90% 54%,
      rgba(255, 218, 130, 0.55) 0 1.3px,
      rgba(255, 218, 130, 0.14) 2px,
      transparent 7px
    ),

    radial-gradient(
      circle at 18% 72%,
      rgba(255, 229, 158, 0.65) 0 1.5px,
      rgba(255, 229, 158, 0.12) 2.3px,
      transparent 7px
    ),

    radial-gradient(
      circle at 75% 83%,
      rgba(255, 235, 180, 0.55) 0 1.4px,
      rgba(255, 235, 180, 0.12) 2px,
      transparent 7px
    ),

    radial-gradient(
      circle at 35% 32%,
      rgba(255, 241, 196, 0.40) 0 1px,
      transparent 5px
    );

  opacity: 0.8;

  animation: brilhoJardim 4s ease-in-out infinite alternate;
}


/* =========================================
   CAMADA DE FOLHAGENS DESFOCADAS
   ========================================= */

.modal::after {
  content: "";

  position: absolute;
  inset: -8%;

  pointer-events: none;
  z-index: 0;

  background:
    radial-gradient(
      ellipse at 4% 12%,
      rgba(58, 78, 54, 0.75) 0%,
      rgba(36, 54, 38, 0.45) 20%,
      transparent 48%
    ),

    radial-gradient(
      ellipse at 96% 15%,
      rgba(56, 76, 52, 0.70) 0%,
      rgba(32, 50, 35, 0.40) 22%,
      transparent 50%
    ),

    radial-gradient(
      ellipse at 2% 88%,
      rgba(33, 49, 35, 0.80) 0%,
      rgba(22, 37, 26, 0.48) 22%,
      transparent 52%
    ),

    radial-gradient(
      ellipse at 98% 88%,
      rgba(35, 52, 37, 0.75) 0%,
      rgba(21, 36, 25, 0.44) 22%,
      transparent 52%
    );

  filter: blur(18px);

  opacity: 0.82;
}


/* garante que o card fique acima das camadas */
.modal-card {
  position: relative;
  z-index: 2;
}


/* =========================================
   BRILHO SUAVE AO REDOR DO CARD
   ========================================= */

.modal-card::before {
  content: "";

  position: absolute;
  inset: -18px;

  z-index: -1;
  pointer-events: none;

  border-radius: 40px;

  background:
    radial-gradient(
      circle at center,
      rgba(198, 177, 112, 0.10),
      rgba(117, 139, 102, 0.06) 45%,
      transparent 72%
    );

  filter: blur(16px);
}


/* =========================================
   ANIMAÇÃO DOS VAGALUMES
   ========================================= */

@keyframes brilhoJardim {
  0% {
    opacity: 0.55;
    transform: scale(1);
  }

  100% {
    opacity: 0.9;
    transform: scale(1.01);
  }
}